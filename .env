# ============================================
# PortalSettings
# ============================================
PORTAL_DB_POSTGRES_USER=portaluser
PORTAL_DB_POSTGRES_PASSWORD=portalpass
PORTAL_DB_POSTGRES_DB=citizenportaldb
PORTAL_DB_CONNECTION=Host=citizen-portal-db;Database=citizenportaldb;Username=portaluser;Password=portalpass;Include Error Detail=true
FRONTEND_REDIRECTURI=https://localhost
# Comma-separated extra CORS origins when using Traefik (https://localhost) alongside direct Vite port.
FRONTEND_CORS_ORIGINS=http://localhost:5173,https://localhost,http://localhost:5051

# ============================================
# Traefik + oauth2-proxy (same pattern as talent)
# ============================================
BASE_URL=https://localhost
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://keycloak:8443/realms/CitizenRealm
OAUTH2_PROXY_CLIENT_ID=citizen-app
OAUTH2_PROXY_CLIENT_SECRET=rpC8odnaEbiwKKxVwcg8yle2bobgFUA2
# Same as talent: 32 hex characters = 32 bytes raw (not base64 — base64 decodes wrong length for oauth2-proxy v7).
OAUTH2_PROXY_COOKIE_SECRET=900b70f9fa83554c2e2abf2b1b6a4a4d
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_CODE_CHALLENGE_METHOD=S256
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_SKIP_JWT_BEARER_TOKENS=true
OAUTH2_PROXY_BEARER_TOKEN_HEADER=Authorization
OAUTH2_PROXY_SKIP_OIDC_DISCOVERY=true
OAUTH2_PROXY_LOGIN_URL=https://keycloak:8443/realms/CitizenRealm/protocol/openid-connect/auth
OAUTH2_PROXY_REDEEM_URL=https://keycloak:8443/realms/CitizenRealm/protocol/openid-connect/token
OAUTH2_PROXY_OIDC_JWKS_URL=https://keycloak:8443/realms/CitizenRealm/protocol/openid-connect/certs
OAUTH2_PROXY_OIDC_CA_FILE=/etc/ssl/certs/keycloak-ca.crt
OAUTH2_PROXY_INSECURE_OIDC_SKIP_ISSUER_VERIFICATION=true
OAUTH2_PROXY_SSL_INSECURE_SKIP_VERIFY=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_REDIRECT_URL=https://localhost/oauth2/callback

# ============================================
# KeycloakSettings
# ============================================

# KeycloakSettings (Shared)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KC_HOSTNAME=https://localhost:8443
KC_HOSTNAME_ADMIN=https://localhost:8443
KC_HOSTNAME_BACKCHANNEL_DYNAMIC= "true"
# KC_PROXY_HEADERS=xforwarded
KC_HTTP_ENABLED=false
KEYCLOAK_BASEURL=https://keycloak:8443

# Must match Traefik API URL when SPA is https://localhost (same-site cookie for refresh_token).
KEYCLOAK_PORTAL_REDIRECTURI=https://localhost/api/citizen-portal/authentication/oauth2callback
KEYCLOAK_PORTAL_REALM=CitizenRealm
KEYCLOAK_PORTAL_CLIENTID=citizen-app
KEYCLOAK_PORTAL_CLIENTSECRET=rpC8odnaEbiwKKxVwcg8yle2bobgFUA2
KEYCLOAK_PORTAL_AUTHORITY=https://keycloak:8443/realms/CitizenRealm

# Keycloak DB Configuration (Shared)
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://keycloak-db:5432/keycloakdb
KC_DB_USERNAME=keycloakuser
KC_DB_PASSWORD=keycloakpass
KC_DB_POSTGRES_DB=keycloakdb

# ============================================
# KafkaSettings
# ============================================

# Kafka Configuration Resilience - reconnect / socket
KAFKA_BOOTSTRAP_SERVERS=kafka1:19092
PORTAL_KAFKA_RECONNECT_BACKOFF_MS=50
PORTAL_KAFKA_RECONNECT_BACKOFF_MAX_MS=10000
PORTAL_KAFKA_SOCKET_CONNECTION_SETUP_TIMEOUT_MS=10000
PORTAL_KAFKA_SOCKET_TIMEOUT_MS=30000

# Kafka Producer
PORTAL_KAFKA_SUBMITTED_TOPIC=citizen.application.submitted
PORTAL_KAFKA_EMAIL_TOPIC=notifications.email.citizen
PORTAL_KAFKA_RETRY_BACKOFF_MS=100
PORTAL_KAFKA_REQUEST_TIMEOUT_MS=30000
PORTAL_KAFKA_MESSAGE_TIMEOUT_MS=120000

# Kafka Consumer
PORTAL_KAFKA_CONSUMER_GROUP=citizen-portal-consumers
PORTAL_KAFKA_PROTOCOL_TOPIC=citizen.application.protocol-assigned
PORTAL_KAFKA_AUTO_OFFSET_RESET=Earliest
PORTAL_KAFKA_SESSION_TIMEOUT_MS=30000
PORTAL_KAFKA_MAX_POLL_INTERVAL_MS=300000

# ============================================
# StorageClientSettings
# ============================================
DMS_STORAGE_URL= http://storage-service:8080

# ============================================
# Frontend (Vite) — see citizen-frontend-service/vite.config.ts envDir
# ============================================
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.1
VITE_SENTRY_DSN=
VITE_SENTRY_ENABLED=false
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1
# With Traefik + https://localhost SPA, use gateway API (session probe + RTK). Direct API only: http://localhost:5051
VITE_API_BASE_URL=https://localhost/api/citizen-portal

# OIDC IdP hints / scope (browser Keycloak URL: KC_HOSTNAME; realm/client/redirect: KEYCLOAK_PORTAL_* — see vite.config define).
VITE_OIDC_SCOPE=openid
VITE_OIDC_IDP_HINT_TAXISNET=gsis-taxis-test
VITE_OIDC_IDP_HINT_PUBLIC_SECTOR=gsis-govuser-test

# GSIS federated logout (browser redirect after successful Keycloak logout)
# TaxisNet — pilot: test.gsis.gr — production: oauth2.gsis.gr
VITE_GSIS_OAUTH_HOST_TAXISNET=https://test.gsis.gr
VITE_GSIS_OAUTH_SERVER_PATH_TAXISNET=oauth2server
# ΔΔ — pilot: test.gsis.gr — production: www1.gsis.gr
VITE_GSIS_OAUTH_HOST_PUBLIC_SECTOR=https://test.gsis.gr
VITE_GSIS_OAUTH_SERVER_PATH_PUBLIC_SECTOR=oauth2servergov
VITE_GSIS_OAUTH_CLIENT_ID_TAXISNET=TYWGBC48886
VITE_GSIS_OAUTH_CLIENT_ID_PUBLIC_SECTOR=T5ZV1548887
# Must match domain registered in ΕΔΑ (defaults to FRONTEND_REDIRECTURI when unset)
VITE_GSIS_LOGOUT_REDIRECT_URL=https://localhost

# Session probe — CitizenBE: POST `/Authentication/refresh` (same origin cookies). Must match `FRONTEND_REDIRECTURI` port with CitizenBE CORS.
# VITE_AUTH_SESSION_PROBE_URL=http://localhost:5051/Authentication/refresh
VITE_AUTH_SESSION_PROBE_PATH=/Authentication/refresh
VITE_AUTH_SESSION_PROBE_METHOD=POST

ASPNETCORE_ENVIRONMENT=Development